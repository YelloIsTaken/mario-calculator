<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_operator_pressed" />
            <stroke android:width="3dp" android:color="@color/btn_operator_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_operator_bg" />
            <stroke android:width="3dp" android:color="@color/btn_operator_border" />
        </shape>
    </item>
</selector>
