<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Memory Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:background="@color/bg_header"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_memory_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/memory_label"
            android:textColor="@color/color_cyan"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/tv_memory_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/color_cyan"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- History Box -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="2dp">

        <ScrollView
            android:id="@+id/sv_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_history"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tv_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text=""
                android:textColor="@color/color_green"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:hint="@string/history_hint"
                android:textColorHint="@color/color_green"
                android:gravity="bottom" />
        </ScrollView>
    </FrameLayout>

    <!-- Main Display -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/tv_display"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_display"
            android:gravity="center_vertical|end"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="start" />
    </FrameLayout>

    <!-- Mario Animation Scene -->
    <com.mario.calculator.MarioView
        android:id="@+id/mario_view"
        android:layout_width="match_parent"
        android:layout_height="70dp" />

    <!-- Navigation Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="@color/bg_nav"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <Button
            android:id="@+id/btn_exit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_exit"
            android:textColor="@color/color_white"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:background="@drawable/btn_nav"
            android:layout_marginEnd="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/btn_unit_converter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:text="@string/btn_unit_converter"
            android:textColor="@color/color_white"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:background="@drawable/btn_nav"
            android:layout_marginHorizontal="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/btn_help"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_help"
            android:textColor="@color/color_white"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:background="@drawable/btn_nav"
            android:layout_marginStart="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <!-- Button Grid (fills remaining space) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:paddingBottom="3dp">

        <!-- Row 1: Memory buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingTop="3dp">

            <Button
                android:id="@+id/btn_mc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="MC"
                android:textColor="@color/color_white"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_memory"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_mr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="MR"
                android:textColor="@color/color_white"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_memory"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_mminus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="M−"
                android:textColor="@color/color_white"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_memory"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_mplus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="M+"
                android:textColor="@color/color_white"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_memory"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_c"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="C"
                android:textColor="@color/color_white"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_clear"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- Row 2: 7 8 9 % CE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingTop="3dp">

            <Button
                android:id="@+id/btn_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="7"
                android:textColor="@color/color_dark_text"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="8"
                android:textColor="@color/color_dark_text"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="9"
                android:textColor="@color/color_dark_text"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_percent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="%"
                android:textColor="@color/color_white"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_operator"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_ce"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="CE"
                android:textColor="@color/color_white"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_operator"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- Row 3: 4 5 6 × ÷ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingTop="3dp">

            <Button
                android:id="@+id/btn_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="4"
                android:textColor="@color/color_dark_text"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="5"
                android:textColor="@color/color_dark_text"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="6"
                android:textColor="@color/color_dark_text"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_multiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="×"
                android:textColor="@color/color_white"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_operator"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_divide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="÷"
                android:textColor="@color/color_white"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_operator"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- Row 4: 1 2 3 + − -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingTop="3dp">

            <Button
                android:id="@+id/btn_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1"
                android:textColor="@color/color_dark_text"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="2"
                android:textColor="@color/color_dark_text"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3"
                android:textColor="@color/color_dark_text"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_add"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="+"
                android:textColor="@color/color_white"
                android:textSize="22sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_operator"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_subtract"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="−"
                android:textColor="@color/color_white"
                android:textSize="22sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_operator"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- Row 5: 0 00 . = (= spans 2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingTop="3dp">

            <Button
                android:id="@+id/btn_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="0"
                android:textColor="@color/color_dark_text"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_00"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="00"
                android:textColor="@color/color_dark_text"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_dot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="."
                android:textColor="@color/color_dark_text"
                android:textSize="22sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btn_equals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:text="="
                android:textColor="@color/color_white"
                android:textSize="24sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@drawable/btn_equals"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
