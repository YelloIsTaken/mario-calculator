<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/bg_dark"
    android:padding="12dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/unit_converter_title"
        android:textColor="@color/color_cyan"
        android:textSize="11sp"
        android:fontFamily="@font/press_start_2p"
        android:gravity="center"
        android:paddingBottom="16dp"
        android:letterSpacing="0.05" />

    <!-- Category Spinner -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/unit_converter_category_label"
        android:textColor="@color/color_green"
        android:textSize="8sp"
        android:fontFamily="@font/press_start_2p"
        android:paddingBottom="6dp" />

    <Spinner
        android:id="@+id/spinner_category"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_history"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/color_green"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- FROM section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/unit_converter_from_label"
        android:textColor="@color/color_cyan"
        android:textSize="9sp"
        android:fontFamily="@font/press_start_2p"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/spinner_from_unit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_history"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/et_from_value"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_display"
            android:textColor="@color/color_white"
            android:textColorHint="@color/color_hint"
            android:hint="0"
            android:inputType="numberDecimal|numberSigned"
            android:textSize="14sp"
            android:fontFamily="@font/press_start_2p"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center_vertical|end" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider_subtle"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp" />

    <!-- TO section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/unit_converter_to_label"
        android:textColor="@color/color_cyan"
        android:textSize="9sp"
        android:fontFamily="@font/press_start_2p"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/spinner_to_unit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_history"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_to_value"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_display"
            android:textColor="@color/color_cyan"
            android:text="0"
            android:textSize="14sp"
            android:fontFamily="@font/press_start_2p"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center_vertical|end"
            android:singleLine="true"
            android:ellipsize="start" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/color_green"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp" />

    <!-- Back Button -->
    <Button
        android:id="@+id/btn_back"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/back_label"
        android:textColor="@color/color_white"
        android:textSize="9sp"
        android:fontFamily="@font/press_start_2p"
        android:background="@drawable/btn_nav"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

</LinearLayout>
